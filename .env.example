# Application
APP_NAME="DCLM Server"
VERSION=1.3.0
DEBUG=false

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-random-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Database
# Local development:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dclm_db

# Supabase runtime, prefer the transaction pooler for deployed app traffic.
# If your password contains special URL characters like #, either percent-encode
# it as %23 or paste it raw; the app normalizes it before parsing.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional migration URL. Alembic auto-derives psycopg2 from DATABASE_URL when
# this is absent. Set it explicitly if your migration host differs from runtime.
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Connection pool
# Keep this conservative on small Supabase plans and lower it if you run multiple workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600

# Email (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]
